# ===================================================================
#  OS996 Smart Home Project —— Git 忽略规则
# ===================================================================
#  语法速查：
#    # 开头      = 注释
#    空行        = 忽略
#    name/       = 只匹配【目录】
#    /name       = 只匹配【仓库根目录】下的 name（不递归匹配子目录）
#    name        = 匹配任意层级的 name
#    *.ext       = 匹配任意层级的该扩展名文件
#    **          = 匹配任意多级目录
#    !name       = 取消忽略（例外规则，必须放在后面的排除规则之后）
# ===================================================================


# ---------------------------------------------------------------
# 1. 编译产物（最重要 —— 这一项就是 35MB）
# ---------------------------------------------------------------
# CMake 的构建输出目录，每次编译都会重建，绝不能进仓库
build/

# 备用构建目录名（有些工程用 build-<preset> 或 out/）
build-*/
out/


# ---------------------------------------------------------------
# 2. 编译中间文件
# ---------------------------------------------------------------
# 对象文件
*.o
*.obj
*.d

# ARM GCC 的栈使用分析文件（-fstack-usage 生成）
*.su

# 可执行/固件镜像
*.elf
*.bin
*.hex
*.axf
*.s19
*.srec

# 链接器产物
*.map
*.lst
*.lnp
*.sct

# Keil 的中间/报告文件（万一以后用 Keil 打开）
*.crf
*.dep
*.htm
*.build_log.htm
JLinkLog.txt
JLinkSettings.ini
*.uvguix.*
*.scvd

# IAR
Debug/
Release/
*.ewt
*.ewp.bak


# ---------------------------------------------------------------
# 3. CMake 生成物
# ---------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
install_manifest.txt


# ---------------------------------------------------------------
# 4. STM32CubeMX 临时/备份文件
# ---------------------------------------------------------------
# CubeMX 的内部缓存（重新打开 .ioc 时会自动重建）
.mxproject
*.mxproject.bak
.ioc.bak

# 说明：.ioc 本身【要提交】——它是工程配置的唯一来源，
#       没有它就无法重新生成代码。


# ---------------------------------------------------------------
# 5. VS Code 本机专属配置
# ---------------------------------------------------------------
# 这两个文件里写死了【本机的绝对路径】（D:/cubeMXIDE/...、C:/Users/...），
# 换台电脑就失效，所以不提交。
#
# 保留提交的是：atk-dap.cfg / launch.json / tasks.json
#   —— 它们虽然也有本机路径，但记录了"ATK-DAP 必须用 hid 后端"
#      这种踩坑经验，有参考价值。换电脑时手工改路径即可。
.vscode/settings.json
.vscode/c_cpp_properties.json


# ---------------------------------------------------------------
# 6. 操作系统 / 编辑器垃圾文件
# ---------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS（万一以后在别的机器上打开）
.DS_Store
._*

# Vim / Emacs 的临时文件
*.swp
*.swo
*~
\#*\#
.\#*
