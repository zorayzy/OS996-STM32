{
  "//": "=================== OS996 debug config ===================",
  "//A": "Uses ATK-DAP (ALIENTEK CMSIS-DAP probe, USB VID 04D8/PID 00DF)",
  "//B": "IMPORTANT: .vscode/atk-dap.cfg forces 'cmsis-dap backend hid'.",
  "//C": "Without it OpenOCD's default backend 'auto' tries usb_bulk first,",
  "//D": "fails, and exits with 'unable to find a matching CMSIS-DAP device'.",
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flash & Debug (ATK-DAP + OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "serverpath": "C:/Users/28062/.platformio/packages/tool-openocd/bin/openocd.exe",
      "searchDir": [
        "C:/Users/28062/.platformio/packages/tool-openocd/openocd/scripts"
      ],
      "configFiles": [
        "${workspaceFolder}/.vscode/atk-dap.cfg",
        "target/stm32f4x.cfg"
      ],

      "//E": "Board MCU reported by OpenOCD: device id 0x101f6413 = STM32F407xE (512KB flash).",
      "//F": "The CubeMX project is configured as ZGT6 (1024KB); harmless while code < 512KB.",
      "device": "STM32F407ZET6",

      "armToolchainPath": "D:/arm-gnu-toolchain/bin",
      "executable": "${workspaceFolder}/build/Debug/OS996.elf",
      "cwd": "${workspaceFolder}",

      "runToEntryPoint": "main",
      "preLaunchTask": "CMake: build",

      "//G": "Set to \"raw\" if you need to inspect GDB transactions when debugging",
      "showDevDebugOutput": "none",
      "breakAfterReset": false
    },
    {
      "name": "Attach (ATK-DAP + OpenOCD)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "serverpath": "C:/Users/28062/.platformio/packages/tool-openocd/bin/openocd.exe",
      "searchDir": [
        "C:/Users/28062/.platformio/packages/tool-openocd/openocd/scripts"
      ],
      "configFiles": [
        "${workspaceFolder}/.vscode/atk-dap.cfg",
        "target/stm32f4x.cfg"
      ],
      "device": "STM32F407ZET6",
      "armToolchainPath": "D:/arm-gnu-toolchain/bin",
      "executable": "${workspaceFolder}/build/Debug/OS996.elf",
      "cwd": "${workspaceFolder}"
    }
  ]
}
